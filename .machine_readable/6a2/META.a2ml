;; META.a2ml — Meta-level information for tlaiser

(meta
  (version "0.1.0")
  (last-updated "2026-03-21")

  (architecture-decisions
    (adr "001-iser-pattern"
      (status "accepted")
      (context "Need to make TLA+/PlusCal model checking accessible without learning TLA+ syntax")
      (decision "Use manifest-driven code generation: user describes state machines in TOML, tlaiser generates TLA+ specs and runs TLC")
      (consequences "Users write zero TLA+; all spec generation complexity is in the -iser"))

    (adr "002-abi-ffi-standard"
      (status "accepted")
      (context "Need verified interop between Rust CLI, state extraction engine, and TLC runtime")
      (decision "Idris2 ABI for formal proofs (StateMachine, TemporalFormula, ModelCheckResult), Zig FFI for C-ABI bridge")
      (consequences "Compile-time correctness guarantees for state machine types; zero runtime overhead from proofs"))

    (adr "003-rsr-template"
      (status "accepted")
      (context "Need consistent project structure across 29+ -iser repos")
      (decision "All repos cloned from rsr-template-repo with full CI/CD and governance")
      (consequences "17 workflows, SECURITY.md, CONTRIBUTING, bot directives from day one"))

    (adr "004-tlc-subprocess"
      (status "accepted")
      (context "TLC model checker is a Java application (tla2tools.jar)")
      (decision "Invoke TLC as a subprocess rather than embedding JVM; parse stdout/stderr for results")
      (consequences "Requires Java runtime; avoids JNI complexity; clean process isolation"))

    (adr "005-temporal-logic-types"
      (status "accepted")
      (context "TLA+ has rich temporal operators (Box, Diamond, LeadsTo, Fairness) that must be represented in the type system")
      (decision "Idris2 GADTs for TemporalFormula with constructors for each operator; dependent types ensure well-formedness")
      (consequences "Cannot construct ill-formed temporal formulae at compile time; SafetyProperty and LivenessProperty are distinct types")))

  (development-practices
    (language "Rust" (purpose "CLI orchestration, manifest parsing, codegen templates"))
    (language "Idris2" (purpose "ABI formal proofs — StateMachine, TemporalFormula, etc."))
    (language "Zig" (purpose "FFI C-ABI bridge — state extraction, TLC process management"))
    (language "TLA+" (purpose "Generated output — model checking specifications"))
    (build-tool "cargo")
    (ci "GitHub Actions (17 workflows)"))

  (design-rationale
    (principle "Manifest-driven"
      (explanation "User describes state machines and properties in tlaiser.toml; all TLA+ generation is deterministic and reproducible"))
    (principle "Formally verified bridges"
      (explanation "Idris2 dependent types prove state machine and temporal formula correctness at compile time"))
    (principle "Zero TLA+ exposure"
      (explanation "Users never write TLA+/PlusCal — tlaiser handles spec generation, TLC invocation, and result parsing"))
    (principle "Exhaustive verification"
      (explanation "TLC explores ALL possible state interleavings, unlike testing which only covers exercised paths"))))
